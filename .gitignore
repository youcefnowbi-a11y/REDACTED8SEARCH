# ── RE_Library : what ships is the ANALYSIS, not the corpus ──
# Sources are public at known commits; binaries are 3rd-party and large.

# Third-party source clones (public, re-obtainable)
01_SOURCE_c2/
01_SOURCE_mobile/

# Third-party binaries + extracted archives (large, not ours to redistribute)
02_BINARIES/
05_TARGETS/
03_SAMPLES/

# Scratch: extraction dumps, raw string spills, per-target work products
07_OUTPUT/extractions/

# Tooling scratch: intermediate .gem extraction layers (data.tar / data.tar.gz)
# The unpacked *source* trees (rex-socket-0.1.71/ etc.) stay tracked; only the
# throwaway stages go. Trailing slash matters: rs/ is scratch, rs3/ is not.
04_TOOLS/gems/rs/
04_TOOLS/gems/rs2/
04_TOOLS/gems/final/
04_TOOLS/gems/*.gem
04_TOOLS/gems/**/*.gem
04_TOOLS/gems/data.tar
04_TOOLS/gems/**/data.tar
04_TOOLS/gems/**/*.gz

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
